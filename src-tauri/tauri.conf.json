{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "青简",
  "mainBinaryName": "qingjian",
  "version": "0.1.1",
  "identifier": "com.soulmte.qingjian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "青简",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Qingjian.Markdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "windows": {
      "wix": {
        "language": ["zh-CN"],
        "upgradeCode": "76718746-ec69-5276-8b16-2662f86e5b52"
      }
    }
  }
}
